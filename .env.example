# ==============================================================================
# Farm Bundle Tracker - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (Docker Compose local service)
# ------------------------------------------------------------------------------
POSTGRES_USER=farm
POSTGRES_PASSWORD=farm
POSTGRES_DB=farm_bundle_tracker
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Backend Service (NestJS API)
# ------------------------------------------------------------------------------
# Node runtime environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server port the NestJS API listens on
PORT=3000

# PostgreSQL connection string used by Drizzle ORM
# For local dev: postgresql://<user>:<password>@localhost:<port>/<db>
# In production Docker Compose network: postgresql://<user>:<password>@postgres:5432/<db>
DATABASE_URL=postgresql://farm:farm@localhost:5432/farm_bundle_tracker

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HMAC access tokens.
# IMPORTANT: In production, generate a long random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret

# Expiration duration for short-lived access tokens (stored in client memory)
JWT_ACCESS_EXPIRES_IN=15m

# Expiration duration for rotating refresh tokens (persisted as hashes in DB)
JWT_REFRESH_EXPIRES_IN=7d

# SameSite policy for the refresh cookie: 'lax' | 'strict' | 'none'
# Use 'lax' for same-site or top-level navigation; use 'none' if cross-domain with HTTPS
REFRESH_COOKIE_SAME_SITE=lax

# Optional cookie customization (defaults shown)
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Port for the Vite development server
FRONTEND_PORT=5173

# Allowed CORS origin(s) for the API. Comma-separate multiple origins if needed.
# Local dev: http://localhost:5173
# Production example: https://bundle-tracker.com
FRONTEND_URL=http://localhost:5173

# Base API URL used by the web client (compiled at build time by Vite)
# Local dev: http://localhost:3000
# Production example: https://bundle-tracker.com
VITE_API_URL=http://localhost:3000
