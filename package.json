{
  "name": "farm-bundle-tracker",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:check": "npm run lint:check --workspaces",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "dev:backend": "DOTENV_CONFIG_PATH=../../.env npm run start:dev -w backend",
    "dev:frontend": "DOTENV_CONFIG_PATH=../../.env npm run dev -w frontend"
  }
}
